---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'お問い合わせ',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="お問い合わせ"
    subtitle="事業に関するご質問・ご相談など、お気軽にご連絡ください。"
  />

  <Features2
    title="連絡先情報"
    items={[
      {
        title: 'メール',
        description: 'info@maydata.jp',
        icon: 'tabler:mail',
      },
      {
        title: '所在地',
        description: '北海道札幌市',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
