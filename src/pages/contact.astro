---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'お問い合わせ',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact" title="お問い合わせ" />

  <ContactUs
    id="form"
    title="お気軽にお問い合わせください"
    subtitle="事業に関するご質問・ご相談など、下記フォームよりお気軽にお問い合わせください。"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'お名前',
      },
      {
        type: 'email',
        name: 'email',
        label: 'メールアドレス',
      },
    ]}
    textarea={{
      label: 'お問い合わせ内容',
    }}
    disclaimer={{
      label: 'お問い合わせにあたり、個人情報の取り扱いに同意します。',
    }}
    description="通常2営業日以内にご返信いたします。"
  />

  <Features2
    title="連絡先情報"
    items={[
      {
        title: 'メール',
        description: 'info@maydata.jp',
        icon: 'tabler:mail',
      },
      {
        title: '所在地',
        description: '北海道札幌市',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
