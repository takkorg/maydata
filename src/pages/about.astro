---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '会社概要',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero tagline="About us">
    <Fragment slot="title">
      株式会社メイデータ<br />
      <span class="text-accent dark:text-white">MayDATA Inc.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Medical AI with Your DATA — 医療AI研究開発 × データエンジニアリング
    </Fragment>
  </Hero>

  <!-- 会社概要 -->

  <Features2
    tagline="Company"
    title="会社情報"
    columns={2}
    items={[
      { title: '会社名', description: '株式会社メイデータ (MayDATA Inc.)' },
      { title: '設立', description: '2023年4月3日（登記申請日）' },
      { title: '代表', description: '兒玉拓巳' },
      { title: '所在地', description: '北海道（釧路）、沖縄' },
      { title: '事業内容', description: 'ソフトウェア開発、不動産事業' },
      { title: '屋号の由来', description: 'Medical AI with Your DATA の頭文字' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- 会社の強み -->

  <Content
    tagline="Strength"
    title="会社の強み"
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Data Analysis',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted dark:text-slate-400">
        研究機関でのアカデミック研究開発と、商用ベースの安定したアプリケーション開発は、通常トレードオフの関係にあります。メイデータはその両方の経験を持つチームにより、研究知見に裏打ちされた商用品質のアプリケーションを受託&自社開発しています。国の研究機関、大手企業からの受注実績があります。
      </p>
    </Fragment>
  </Content>

  <!-- 拠点 -->

  <Features2
    tagline="Locations"
    title="拠点"
    columns={2}
    items={[
      { title: '北海道（釧路）', description: '本社所在地' },
      { title: '沖縄', description: '開発拠点' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- 代表プロフィールへ -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '代表プロフィールを見る',
        href: '/founder',
      },
    ]}
  >
    <Fragment slot="title">代表プロフィール</Fragment>
    <Fragment slot="subtitle">
      代表取締役 兒玉拓巳の経歴・研究業績はこちら
    </Fragment>
  </CallToAction>
</Layout>
