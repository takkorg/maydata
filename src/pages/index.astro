---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'MayDATA — Medical AI with Your DATA',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero: スローガン・ビジョン -->

  <Hero
    tagline="Medical AI with Your DATA"
    actions={[
      { text: '事業内容', href: '#services' },
      { text: '会社概要', href: '/about' },
      { text: 'お問い合わせ', href: '/contact' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Medical AI Research',
    }}
  >
    <Fragment slot="title">
      医療AI研究開発 ×<br />
      <span class="text-accent dark:text-white">データエンジニアリング</span>
    </Fragment>

    <Fragment slot="subtitle">
      株式会社メイデータ (MayDATA Inc.)
    </Fragment>
  </Hero>

  <!-- 会社の強み -->

  <Content
    tagline="Strength"
    title="会社の強み"
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Data Analysis',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted dark:text-slate-400">
        研究機関でのアカデミック研究開発と、商用ベースの安定したアプリケーション開発は、通常トレードオフの関係にあります。メイデータはその両方の経験を持つチームにより、研究知見に裏打ちされた商用品質のアプリケーションを受託&自社開発しています。国の研究機関、大手企業からの受注実績があります。
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 事業の柱 -->

  <Features
    id="services"
    tagline="Business"
    title="事業の柱"
    columns={3}
    items={[
      {
        title: 'A. ニーズベースR&D',
        description:
          'クライアントの課題に応じた研究開発・アプリケーション構築。国立研究機関向けBCI脳波解析プラットフォーム、大手企業向けパフォーマンス・バイオメカニクスデータのリアルタイム収集・BigQueryビッグデータ分析基盤など。',
        icon: 'tabler:code',
      },
      {
        title: 'B. シーズベースR&D',
        description:
          '研究機関の医療リアルワールドデータ(RWD)を用いたAIモデルの研究開発。',
        icon: 'tabler:brain',
      },
      {
        title: 'C. 不動産事業（副次的収入源）',
        description:
          '健康をテーマにした働き方を目指すために、北海道(釧路)・東京・沖縄(恩納村)の多拠点で活動しており、それぞれの拠点で不動産を所有・運用・貸し出ししています。',
        icon: 'tabler:building',
      },
    ]}
  />

  <!-- 会社概要 -->

  <Features2
    tagline="Company"
    title="会社概要"
    columns={2}
    items={[
      { title: '会社名', description: '株式会社メイデータ (MayDATA Inc.)' },
      { title: '設立', description: '2023年4月3日' },
      { title: '代表', description: '兒玉拓巳' },
      { title: '所在地', description: '北海道（釧路）、沖縄' },
      { title: '事業内容', description: 'ソフトウェア開発、不動産事業' },
      { title: '屋号の由来', description: 'Medical AI with Your DATA の頭文字' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'お問い合わせ',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">
      お気軽にご相談ください
    </Fragment>

    <Fragment slot="subtitle">
      医療AI研究開発、データ基盤構築、受託開発など、お気軽にお問い合わせください。
    </Fragment>
  </CallToAction>
</Layout>
