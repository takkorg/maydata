---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'MayDATA — Medical AI with Your DATA',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero: スローガン・ビジョン -->

  <Hero
    tagline="Medical AI with Your DATA"
    actions={[
      { text: '事業内容', href: '#services' },
      { text: '会社概要', href: '/about' },
      { text: 'お問い合わせ', href: '/contact' },
    ]}
    image={{
      src: '~/assets/images/hero-sapporo.jpg',
      alt: '札幌の街並み',
    }}
  >
    <Fragment slot="title">
      医療AI研究開発 ×<br />
      <span class="text-accent dark:text-white">データエンジニアリング</span>
    </Fragment>

    <Fragment slot="subtitle"> 株式会社メイデータ (MayDATA Inc.) </Fragment>
  </Hero>

  <!-- 会社の強み -->

  <Content
    tagline="Strength"
    title="会社の強み"
    image={{
      src: '~/assets/images/bci-research.jpg',
      alt: 'BCI脳波解析研究',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted dark:text-slate-400">
        研究機関でのアカデミック研究開発と、商用ベースの安定したアプリケーション開発は、通常トレードオフの関係にあります。メイデータはその両方の経験を持つチームにより、研究知見に裏打ちされた商用品質のプロダクトを開発しています。
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 事業の柱 -->

  <Features
    id="services"
    tagline="Business"
    title="事業の柱"
    columns={3}
    items={[
      {
        title: '医療AIプロダクト開発',
        description:
          '代表自身の抗がん剤治療の経験から、治療中の患者を支援するAIモデルを開発しています。患者が日々記録する体調データと医療リアルワールドデータ(RWD)をAIで統合解析し、副作用リスクの早期予測・検知を目指しています。実用化に向けた研究開発を進めています。',
        icon: 'tabler:brain',
      },
      {
        title: '研究支援アプリ・データ基盤開発',
        description:
          '過去に研究に従事した経験を活かし、研究所向けの遠隔脳波計測・会話支援システムなど、研究の知見を現場で使えるアプリケーションを開発しています。映像・音声・計測データをリアルタイムにやり取りするプラットフォームを構築し、研究と商用開発の両方の経験を活かして、安定した運用まで支えます。',
        icon: 'tabler:database',
      },
      {
        title: 'スポーツ・ヘルスケア事業',
        description:
          'プロスポーツチームに在籍していた経験を活かし、アスリートの体づくりから試合の戦略までを支えるアプリケーションとデータ基盤を開発しています。身体・動作・競技の計測データを統合・可視化し、選手や指導者が日々のトレーニングや試合に役立てられる環境をつくります。',
        icon: 'tabler:activity',
      },
    ]}
  />

  <!-- 会社概要 -->

  <Features2
    tagline="Company"
    title="会社概要"
    columns={2}
    items={[
      { title: '会社名', description: '株式会社メイデータ (MayDATA Inc.)' },
      { title: '設立', description: '2023年4月3日(登記申請日)' },
      { title: '代表', description: '兒玉拓巳' },
      { title: '所在地', description: '北海道(釧路市)、沖縄県(恩納村)' },
      { title: '事業内容', description: '医療AI、研究支援アプリ・データ基盤開発、スポーツ・ヘルスケア' },
      { title: '屋号の由来', description: 'Medical AI with Your DATA の頭文字' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'お問い合わせ',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title"> お問い合わせ </Fragment>

    <Fragment slot="subtitle"> お気軽にご相談ください。 </Fragment>
  </CallToAction>
</Layout>
